                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"123\",\n  \"operationUid\": \"lab4-op-001\",\n  \"systemName\": \"ERP\",\n  \"systemTime\": \"1999-01-01T00:00:00Z\",\n  \"source\": \"Postman\",\n  \"communicationId\": 100,\n  \"templateId\": 8,\n  \"productCode\": 1500,\n  \"smsCode\": 10\n}",
              "options": {
