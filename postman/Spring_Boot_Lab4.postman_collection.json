          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "    const result = pm.response.json();",
                  "    pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "    pm.test(\"code = failed\", function () { pm.expect(result.code).to.eql(\"failed\"); });",
                  "    pm.test(\"Поле errorCode\", function () { pm.expect(result.errorCode).to.eql(\"UnsupportedCodeException\"); });",
                  "})();"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "04. Неизвестная система",
          "request": {
